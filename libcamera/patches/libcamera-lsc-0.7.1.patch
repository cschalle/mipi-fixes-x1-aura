diff --git a/include/libcamera/internal/software_isp/debayer_params.h b/include/libcamera/internal/software_isp/debayer_params.h
index 6772b43..bbdb0a6 100644
--- a/include/libcamera/internal/software_isp/debayer_params.h
+++ b/include/libcamera/internal/software_isp/debayer_params.h
@@ -25,6 +25,30 @@ struct DebayerParams {
 	float gamma = 1.0;
 	float contrastExp = 1.0;
 	RGB<float> gains = RGB<float>({ 1.0, 1.0, 1.0 });
+
+	/*
+	 * Lens shading correction gains, one coarse grid per Bayer channel,
+	 * bilinearly interpolated over the frame by the debayer backend.
+	 *
+	 * The grid is a fixed size array rather than a container because this
+	 * structure lives in memory shared with the IPA. 17x17 matches the grid
+	 * size the rkisp1 hardware uses for the same purpose, which is ample for
+	 * a correction this smooth.
+	 *
+	 * A width or height of zero disables the correction, which is the
+	 * default so that sensors without shading data are unaffected.
+	 */
+	static constexpr unsigned int kLscGridWidth = 17;
+	static constexpr unsigned int kLscGridHeight = 17;
+
+	struct {
+		unsigned int width = 0;
+		unsigned int height = 0;
+		float r[kLscGridHeight][kLscGridWidth] = {};
+		float gr[kLscGridHeight][kLscGridWidth] = {};
+		float gb[kLscGridHeight][kLscGridWidth] = {};
+		float b[kLscGridHeight][kLscGridWidth] = {};
+	} shading;
 };
 
 } /* namespace libcamera */
