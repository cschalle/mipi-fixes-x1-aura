+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, Red Hat Inc.
+ *
+ * Software ISP lens shading correction
+ */
+
+#pragma once
+
+#include <map>
+#include <string>
+
+#include "libcamera/internal/value_node.h"
+
+#include "libipa/lsc_polynomial.h"
+
+#include "algorithm.h"
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+class LensShadingCorrection : public Algorithm
+{
+public:
+	LensShadingCorrection() = default;
+	~LensShadingCorrection() = default;
+
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	int configure(IPAContext &context, const IPAConfigInfo &configInfo) override;
+	void prepare(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     DebayerParams *params) override;
+
+private:
+	/* One radial polynomial per Bayer component, for one illuminant. */
+	using Components = std::map<std::string, ipa::LscPolynomial, std::less<>>;
+
+	void sampleInto(const ipa::LscPolynomial &poly,
+			float dst[DebayerParams::kLscGridHeight]
+				 [DebayerParams::kLscGridWidth]) const;
+
+	std::map<unsigned int, Components> sets_;
+	Rectangle crop_;
+	Size sensorSize_;
+	unsigned int lastCt_ = 0;
+};
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
