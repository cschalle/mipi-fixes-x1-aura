+
+/*
+ * Upload the lens shading grid as an 8 bit RGB texture.
+ *
+ * Gains are stored as (gain - 1) / scale so that no float texture extension is
+ * required, with scale sent alongside so the shader can undo it. Quantising
+ * against the actual range rather than a fixed maximum keeps the step small:
+ * for a 6.35x corner gain it is about 0.02, well under the error already
+ * present in the polynomial fit the grid came from.
+ */
+void DebayerEGL::uploadLscTexture(const DebayerParams &params)
+{
+	const unsigned int gw = params.shading.width;
+	const unsigned int gh = params.shading.height;
+
+	if (!gw || !gh)
+		return;
+
+	float maxGain = 1.0f;
+	for (unsigned int y = 0; y < gh; y++) {
+		for (unsigned int x = 0; x < gw; x++) {
+			maxGain = std::max({ maxGain, params.shading.r[y][x],
+					     params.shading.gr[y][x],
+					     params.shading.gb[y][x],
+					     params.shading.b[y][x] });
+		}
+	}
+
+	const float scale = std::max(maxGain - 1.0f, 1e-3f);
+
+	std::vector<uint8_t> texels(gw * gh * 3);
+	for (unsigned int y = 0; y < gh; y++) {
+		for (unsigned int x = 0; x < gw; x++) {
+			/*
+			 * The two green planes are averaged: the demosaiced
+			 * green already mixes both Bayer greens.
+			 */
+			const float g = (params.shading.gr[y][x] +
+					 params.shading.gb[y][x]) / 2.0f;
+			const float c[3] = { params.shading.r[y][x], g,
+					     params.shading.b[y][x] };
+
+			for (unsigned int i = 0; i < 3; i++) {
+				const float n = (c[i] - 1.0f) / scale * 255.0f;
+				texels[(y * gw + x) * 3 + i] =
+					static_cast<uint8_t>(std::clamp(n, 0.0f, 255.0f));
+			}
+		}
+	}
+
+	if (!lscTexture_) {
+		glGenTextures(1, &lscTexture_);
+		glActiveTexture(GL_TEXTURE7);
+		glBindTexture(GL_TEXTURE_2D, lscTexture_);
+		/* GL_LINEAR gives the bilinear interpolation between nodes. */
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+	} else {
+		glActiveTexture(GL_TEXTURE7);
+		glBindTexture(GL_TEXTURE_2D, lscTexture_);
+	}
+
+	glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+	glTexImage2D(GL_TEXTURE_2D, 0, GL_RGB, gw, gh, 0, GL_RGB,
+		     GL_UNSIGNED_BYTE, texels.data());
+
+	glUniform1i(lscUniformDataIn_, 7);
+	glUniform1f(lscScaleUniformDataIn_, scale);
+}
