+int DebayerCpu::lscApply(int value, float gain, float black)
+{
+	const float corrected = black + (value - black) * gain;
+
+	return std::clamp(static_cast<int>(corrected + 0.5f), 0,
+			  static_cast<int>(kRGBLookupSize) - 1);
+}
+
+/*
+ * Resample the coarse shading grids onto one output line. Doing this per line
+ * rather than per pixel keeps the inner loop to a single multiply-add, and the
+ * correction is far too smooth for the interpolation error to be visible.
+ */
+void DebayerCpu::computeLscRow(unsigned int y, float *b, float *g, float *r) const
+{
+	const auto &shading = params_.shading;
+	const unsigned int gw = shading.width;
+	const unsigned int gh = shading.height;
+	const unsigned int width = window_.width;
+
+	if (!gw || !gh)
+		return;
+
+	const float fy = window_.height > 1
+			       ? static_cast<float>(y) * (gh - 1) / (window_.height - 1)
+			       : 0.0f;
+	const unsigned int y0 = std::min<unsigned int>(fy, gh - 1);
+	const unsigned int y1 = std::min<unsigned int>(y0 + 1, gh - 1);
+	const float wy = fy - y0;
+
+	for (unsigned int x = 0; x < width; x++) {
+		const float fx = width > 1
+				       ? static_cast<float>(x) * (gw - 1) / (width - 1)
+				       : 0.0f;
+		const unsigned int x0 = std::min<unsigned int>(fx, gw - 1);
+		const unsigned int x1 = std::min<unsigned int>(x0 + 1, gw - 1);
+		const float wx = fx - x0;
+
+		auto sample = [&](const float grid[DebayerParams::kLscGridHeight]
+					       [DebayerParams::kLscGridWidth]) {
+			const float top = grid[y0][x0] * (1.0f - wx) + grid[y0][x1] * wx;
+			const float bot = grid[y1][x0] * (1.0f - wx) + grid[y1][x1] * wx;
+			return top * (1.0f - wy) + bot * wy;
+		};
+
+		b[x] = sample(shading.b);
+		/*
+		 * The two green planes are averaged: the debayered green value
+		 * already mixes both Bayer greens, and they differ far less than
+		 * the interpolation error.
+		 */
+		g[x] = (sample(shading.gr) + sample(shading.gb)) / 2.0f;
+		r[x] = sample(shading.r);
+	}
+}
