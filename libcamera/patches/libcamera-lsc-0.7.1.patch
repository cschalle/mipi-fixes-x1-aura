index 5366e01..0e1501c 100644
--- a/src/libcamera/software_isp/swstats_cpu.cpp
+++ b/src/libcamera/software_isp/swstats_cpu.cpp
@@ -189,10 +189,17 @@ static constexpr unsigned int kBlueYMul = 29; /* 0.114 * 256 */
 	yVal += b * kBlueYMul;             \
 	stats.yHistogram[yVal * SwIspStats::kYHistogramSize / (256 * 256 * (div))]++;
 
-#define SWSTATS_FINISH_LINE_STATS() \
-	stats.sum_.r() += sumR;     \
-	stats.sum_.g() += sumG;     \
-	stats.sum_.b() += sumB;
+/*
+ * Normalise the channel sums to 8 bits, the same scale the IPA's black level is
+ * expressed in. Without this the sums for a 10 or 12 bit format stay in the
+ * sensor's native depth while the black level subtracted from them is 8 bit, so
+ * black is under-subtracted and every white balance gain is pulled towards
+ * unity.
+ */
+#define SWSTATS_FINISH_LINE_STATS(div)  \
+	stats.sum_.r() += sumR / (div); \
+	stats.sum_.g() += sumG / (div); \
+	stats.sum_.b() += sumB / (div);
 
