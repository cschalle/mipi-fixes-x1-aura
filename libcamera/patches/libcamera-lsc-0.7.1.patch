diff --git a/src/libcamera/shaders/bayer_unpacked.frag b/src/libcamera/shaders/bayer_unpacked.frag
index 1b85196..7223ef7 100644
--- a/src/libcamera/shaders/bayer_unpacked.frag
+++ b/src/libcamera/shaders/bayer_unpacked.frag
@@ -28,6 +28,15 @@ uniform mat3            ccm;
 uniform vec3            blacklevel;
 uniform float           gamma;
 uniform float           contrastExp;
+#if defined(LSC_ENABLED)
+/*
+ * Lens shading gains on a small grid covering the sensor's analogue crop,
+ * stored as 8 bit (gain - 1) / lscScale so no float texture extension is
+ * needed. GL_LINEAR interpolates between grid nodes for free.
+ */
+uniform sampler2D       lsc;
+uniform float           lscScale;
+#endif
 
 float apply_contrast(float value)
 {
@@ -130,6 +139,14 @@ void main(void) {
 
     rgb = rgb - blacklevel;
 
+#if defined(LSC_ENABLED)
+    /*
+     * Lens shading is a gain on the signal above black level, so it belongs
